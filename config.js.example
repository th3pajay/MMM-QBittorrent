{
  module: "MMM-QBittorrent",
  position: "bottom_left",
  config: {
    host: "http://localhost:8080",   // required — qBittorrent Web UI URL (http:// or https://)
    username: "",
    password: "",

    display: {
      maxItems: 5,                   // max torrents shown (hard cap: 50)
      viewFilter: "all",             // "all" | "downloading" | "completed" | "paused"
      columns: [                     // available: name, size, progress, status, seeds, peers,
        'name',                      //            dlspeed, upspeed, eta, ratio, added_on, actions
        'progress',
        'status',
        'dlspeed',
        'eta',
        'ratio',
        'actions'
      ],
      sortBy: 'added_on',            // any column name listed above
      sortOrder: 'desc',             // "asc" | "desc"
      compact: false,                // tighter row and cell spacing
      scale: 0.6,                    // display scale (0.01 – 10)
      showProgressBar: true,         // false = percentage text only, no bar

      headerDetails: {               // stat panel below the module title (max 9 shown — 3 cols × 3 rows)
        show: true,
        components: [                // remove any entry to hide that stat; order = left-to-right, top-to-bottom
          'downloadedSession',       // bytes downloaded this session
          'uploadedSession',         // bytes uploaded this session
          'downloadLimit',           // global DL cap (∞ = unlimited)
          'uploadLimit',             // global UL cap (∞ = unlimited)
          'totalShareRatio',         // uploaded / downloaded across all torrents
          'completionRatio',         // % of torrents fully downloaded
          'connectedSeeds',          // sum of connected seeds
          'connectedLeechers',       // sum of connected leechers
          'totalPeers',              // seeds + leechers combined
        ]
      },

      colors: {                      // override state colours (null = use theme default)
        rowTint: false,              // true = tint entire row with state colour
        progressBar: {
          downloading: null,         // CSS color string, e.g. "#00e676" or "rgba(0,230,118,0.8)"
          seeding: null,
          stalled: null,
          error: null,
        },
        statusBadge: {
          downloading: null,
          seeding: null,
          paused: null,
          error: null,
          stalled: null,
        }
      },
    },

    polling: {
      updateInterval: 5000,          // ms between polls (min: 1000)
      pollTimeout: 2000,             // request timeout in ms (min: 500)
    },

    connection: {
      tls: {
        rejectUnauthorized: true,    // false = accept self-signed certificates
      }
    },
  }
}
