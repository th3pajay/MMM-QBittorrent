{
  module: "MMM-QBittorrent",
  position: "bottom_left",
  config: {
    // ---- Required ----
    host: "http://localhost:8080",  // qBittorrent Web UI URL (http:// or https://)

    // ---- Credentials (omit if not required) ----
    username: "",
    password: "",

    // ---- Display ----
    maxItems: 5,                    // Max torrents to show (max: 50)
    viewFilter: "all",              // "all" | "downloading" | "completed" | "paused"
    columns: [                      // Available: name, size, progress, status, seeds, peers,
      'name',                       //            dlspeed, upspeed, eta, ratio, added_on, actions
      'progress',
      'status',
      'dlspeed',
      'eta',
      'actions'
    ],
    sortBy: 'added_on',             // Any column name listed above
    sortOrder: 'desc',              // "asc" | "desc"
    compact: false,                 // Reduced row spacing
    scale: 0.6,                     // Display scale (0.01 – 10)
    showProgressBar: true,          // false = show percentage text only

    // ---- Advanced (uncomment to override defaults) ----
    // updateInterval: 5000,        // Poll frequency in ms (min: 1000)
    // pollTimeout: 2000,           // Request timeout in ms (min: 500)
    // rejectUnauthorized: true,    // false = accept self-signed TLS certificates

    // ---- Color overrides (uncomment to customize) ----
    // display: {
    //   colors: {
    //     rowTint: false,
    //     progressBar: { downloading: null, seeding: null, stalled: null },
    //     statusBadge: { downloading: null, seeding: null, paused: null, error: null, stalled: null }
    //   }
    // }
  }
}
